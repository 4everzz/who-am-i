# zmeety.cn —— 技术笔记与作品站
# 放置到 /etc/nginx/conf.d/zmeety.cn.conf
# 若该域名已有站点配置，只改 root，不要整段覆盖。

server {
    listen 80;
    listen [::]:80;
    server_name zmeety.cn www.zmeety.cn;

    # certbot 续期验证目录放行，其余全部跳 https
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://zmeety.cn$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name zmeety.cn;

    root /var/www/zmeety.cn;
    index index.html;

    # 证书路径按签发方式调整
    ssl_certificate     /etc/letsencrypt/live/zmeety.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zmeety.cn/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # www 统一跳主域
    if ($host = www.zmeety.cn) {
        return 301 https://zmeety.cn$request_uri;
    }

    charset utf-8;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # 简历与分享图允许跨站引用
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # 静态资源缓存 7 天；HTML 不缓存，改完立即生效
    location ~* \.(css|js|png|jpg|jpeg|svg|webp|pdf|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location ~* \.html$ {
        add_header Cache-Control "no-cache";
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    access_log /var/log/nginx/zmeety.cn.access.log;
    error_log  /var/log/nginx/zmeety.cn.error.log;
}
