# zmeety.cn —— 静态站配置模板
# 实际位置：/etc/nginx/sites-enabled/zmeety.cn.conf
# 换环境时只需改：server_name / root / 证书路径

server {
    listen 80;
    listen [::]:80;
    server_name zmeety.cn www.zmeety.cn;

    # 证书续期验证目录放行，其余全部跳 https
    location /.well-known/acme-challenge/ {
        root /var/www/zmeety;
    }

    location / {
        return 301 https://zmeety.cn$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl;

    server_name zmeety.cn www.zmeety.cn;

    root /var/www/zmeety;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/zmeety.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zmeety.cn/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # 自定义 404
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # 静态资源可长缓存（CSS/JS 带 ?v= 版本号）；HTML 每次回源校验
    # 只用 expires，不写 add_header，否则会覆盖上面的安全头
    location ~* \.(css|js|svg|png|jpg|jpeg|webp|woff2?)$ {
        expires 30d;
        try_files $uri =404;
    }

    location ~* \.html$ {
        expires -1;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
