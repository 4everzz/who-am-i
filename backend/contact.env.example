# Add these to the existing backend/.env.server. Never commit the filled file.
CONTACT_NOTIFICATION_ENABLED=true
CONTACT_NOTIFICATION_TO=2874951005@qq.com
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=2874951005@qq.com
SMTP_PASSWORD=
SMTP_FROM=2874951005@qq.com
SMTP_USE_SSL=true
# Generate a separate random secret of at least 32 characters; never reuse JWT_SECRET.
CONTACT_RATE_LIMIT_SALT=
CONTACT_RATE_LIMIT_WINDOW_SECONDS=300
CONTACT_RATE_LIMIT_MAX_SUBMISSIONS=3
CONTACT_HOURLY_LIMIT=60
CONTACT_ALLOWED_ORIGINS=https://zmeety.cn,https://www.zmeety.cn
CONTACT_REQUIRE_ORIGIN=true
# Add the actual Docker network gateway or reverse-proxy IP after inspecting the deployed network.
CONTACT_TRUSTED_PROXIES=
